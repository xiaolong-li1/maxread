# Required for real summaries
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SUB_MODULE=
MAXREAD_OPENAI_API_MODE=responses

# Optional runtime settings
MAXREAD_DB=./maxread.sqlite3
MAXREAD_WORKDIR=./var/maxread
MAXREAD_MODEL=gpt-5.5
MAXREAD_FEISHU_AS=bot
MAXREAD_LARK_CLI=lark-cli
MAXREAD_ARXIV_TIMEOUT=45
MAXREAD_ARXIV_PARALLEL_STREAMS=2
MAXREAD_ARXIV_PARALLEL_MIN_BYTES=1048576
MAXREAD_ARXIV_RELAY_URL=
# Optional application-scoped proxy. Only ArxivClient reads this setting.
MAXREAD_ARXIV_PROXY_URL=
MAXREAD_ARXIV_PROXY_REQUIRED=false
MAXREAD_OPENAI_TIMEOUT=180
# Bound optional review/repair calls independently from long generation calls.
MAXREAD_OPENAI_REVIEW_TIMEOUT=240
MAXREAD_OPENAI_REASONING_EFFORT=high
MAXREAD_OPENAI_REVIEW_REASONING_EFFORT=low
# Initial generation plus this many model-assisted repair rounds.
MAXREAD_GENERATION_REPAIR_ROUNDS=1
MAXREAD_QUALITY_REPAIR_ROUNDS=2
# Safe infrastructure/model replay budget after a failed worker attempt.
MAXREAD_AUTO_RETRY_ATTEMPTS=1
MAXREAD_RECOVERY_ATTEMPTS=3
MAXREAD_REQUIRE_SOURCE=true
MAXREAD_FEEDBACK_URL=https://ccnsbbr30xgq.feishu.cn/docx/K7aEdxBKfoyyFnxGaYXcFO40nnd
MAXREAD_QUEUE_WORKERS=2
MAXREAD_QUEUE_STALE_MINUTES=10
MAXREAD_QUEUE_HEARTBEAT_SECONDS=15
MAXREAD_LLM_CONCURRENCY=5
MAXREAD_FEISHU_CONCURRENCY=1
MAXREAD_FEISHU_WRITE_RETRIES=3
MAXREAD_FEISHU_MEDIA_RETRIES=4
MAXREAD_FEISHU_DEFAULT_RETRIES=2

# Five document sections are independent and may run together; global model
# concurrency remains capped at five across all active documents.
MAXREAD_SECTIONAL_GENERATION_ENABLED=true
MAXREAD_SECTIONAL_GENERATION_WORKERS=5
MAXREAD_FIGURE_VISION_WORKERS=2
MAXREAD_QUALITY_BLOCK_WORKERS=2
MAXREAD_FIGURE_RENDER_DPI=200
MAXREAD_MAX_RENDERED_IMAGE_BYTES=10485760
MAXREAD_MAX_RENDERED_IMAGE_SIDE=3200
MAXREAD_MAX_RENDERED_IMAGE_PIXELS=16000000
MAXREAD_MAX_IMAGE_DISPLAY_HEIGHT=560

# Optional post-publish browser QA. The remote worker is isolated; only
# explicitly identified Feishu blocks are changed, then the page is rechecked.
MAXREAD_VISUAL_QA_ENABLED=false
MAXREAD_VISUAL_QA_HOST=
MAXREAD_VISUAL_QA_RUNNER=
MAXREAD_VISUAL_QA_REMOTE_ROOT=
MAXREAD_VISUAL_QA_TIMEOUT=90
MAXREAD_VISUAL_QA_INSPECT_RETRIES=2
MAXREAD_VISUAL_QA_MAX_SECTIONS=12
MAXREAD_VISUAL_QA_MAX_REPAIRS=2
# Number of inspect -> repair -> inspect cycles after publishing.
MAXREAD_VISUAL_QA_REPAIR_ROUNDS=2
MAXREAD_VISUAL_QA_CONCURRENCY=1
MAXREAD_VISUAL_QA_EXPORT_PDF=true
MAXREAD_VISUAL_QA_RUNNER_TIMEOUT=120
MAXREAD_ADMIN_HOST=127.0.0.1
MAXREAD_ADMIN_PORT=8765
# SHA-256 digest of the administrator password. Public dashboard reads remain
# unauthenticated; all POST mutations require a short-lived admin session.
MAXREAD_ADMIN_PASSWORD_SHA256=
# Same-machine browser runner (leave disabled until its smoke test passes).
MAXREAD_VISUAL_QA_ROOT=/opt/maxread-browser
MAXREAD_VISUAL_QA_PYTHON=/opt/maxread/.venv/bin/python
PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
MAXREAD_PLAYWRIGHT_NODE_MODULES=/opt/maxread/var/maxread/playwright-deps/node_modules

# Optional independent model for screenshot-assisted visual repairs. This is
# useful when the primary gateway accepts text but rejects local base64 images.
MAXREAD_VISUAL_OPENAI_API_KEY=
MAXREAD_VISUAL_OPENAI_BASE_URL=
MAXREAD_VISUAL_OPENAI_SUB_MODULE=
MAXREAD_VISUAL_OPENAI_API_MODE=
MAXREAD_VISUAL_MODEL=

# Independent daily duty reminder. Configure the roster with:
# python3 -m maxread.cli duty set --member 'Name=ou_xxx' --member 'Name=ou_yyy'
MAXREAD_DUTY_TIMEZONE=Asia/Shanghai
MAXREAD_DUTY_CHAT_ID=oc_xxx
MAXREAD_DUTY_HOUR=7
MAXREAD_DUTY_MINUTE=0
MAXREAD_DUTY_POLL_SECONDS=30

# Optional bot mention helpers
MAXREAD_BOT_NAMES=读不动了,MaxRead
MAXREAD_BOT_OPEN_ID=
MAXREAD_BOT_UNION_ID=
MAXREAD_BOT_APP_ID=
