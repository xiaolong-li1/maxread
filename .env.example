# Required for real summaries
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SUB_MODULE=
MAXREAD_OPENAI_API_MODE=responses

# Optional runtime settings
MAXREAD_DB=./maxread.sqlite3
MAXREAD_WORKDIR=./var/maxread
MAXREAD_MODEL=gpt-4.1
MAXREAD_FEISHU_AS=bot
MAXREAD_LARK_CLI=lark-cli
MAXREAD_ARXIV_TIMEOUT=45
MAXREAD_ARXIV_PARALLEL_STREAMS=4
MAXREAD_ARXIV_PARALLEL_MIN_BYTES=1048576
MAXREAD_OPENAI_TIMEOUT=180
MAXREAD_OPENAI_REASONING_EFFORT=high
MAXREAD_OPENAI_REVIEW_REASONING_EFFORT=low
# Initial generation plus this many model-assisted repair rounds.
MAXREAD_GENERATION_REPAIR_ROUNDS=2
MAXREAD_QUALITY_REPAIR_ROUNDS=3
MAXREAD_REQUIRE_SOURCE=true
MAXREAD_FEEDBACK_URL=https://ccnsbbr30xgq.feishu.cn/docx/K7aEdxBKfoyyFnxGaYXcFO40nnd
MAXREAD_QUEUE_WORKERS=5
MAXREAD_QUEUE_STALE_MINUTES=10
MAXREAD_QUEUE_HEARTBEAT_SECONDS=15
MAXREAD_LLM_CONCURRENCY=5
MAXREAD_FEISHU_CONCURRENCY=5
MAXREAD_FEISHU_WRITE_RETRIES=3
MAXREAD_FEISHU_MEDIA_RETRIES=4
MAXREAD_FEISHU_DEFAULT_RETRIES=2

# Optional post-publish browser QA. The remote worker is isolated and read-only;
# only deterministic block repairs are applied locally, then rechecked.
MAXREAD_VISUAL_QA_ENABLED=false
MAXREAD_VISUAL_QA_HOST=ziplab-5090
MAXREAD_VISUAL_QA_RUNNER=/home/lixiaolong/.local/share/maxread-browser/run_visual_qa.sh
MAXREAD_VISUAL_QA_REMOTE_ROOT=/home/lixiaolong/.local/share/maxread-browser
MAXREAD_VISUAL_QA_TIMEOUT=90
MAXREAD_VISUAL_QA_INSPECT_RETRIES=2
MAXREAD_VISUAL_QA_MAX_SECTIONS=12
MAXREAD_VISUAL_QA_MAX_REPAIRS=2
# Number of inspect -> repair -> inspect cycles after publishing.
MAXREAD_VISUAL_QA_REPAIR_ROUNDS=3

# Optional independent model for screenshot-assisted visual repairs. This is
# useful when the primary gateway accepts text but rejects local base64 images.
MAXREAD_VISUAL_OPENAI_API_KEY=
MAXREAD_VISUAL_OPENAI_BASE_URL=
MAXREAD_VISUAL_OPENAI_SUB_MODULE=
MAXREAD_VISUAL_OPENAI_API_MODE=
MAXREAD_VISUAL_MODEL=

# Independent daily duty reminder. Configure the roster with:
# python3 -m maxread.cli duty set --member 'Name=ou_xxx' --member 'Name=ou_yyy'
MAXREAD_DUTY_TIMEZONE=Asia/Shanghai
MAXREAD_DUTY_CHAT_ID=oc_xxx
MAXREAD_DUTY_HOUR=7
MAXREAD_DUTY_MINUTE=0
MAXREAD_DUTY_POLL_SECONDS=30

# Optional bot mention helpers
MAXREAD_BOT_NAMES=读不动了,MaxRead
MAXREAD_BOT_OPEN_ID=
MAXREAD_BOT_UNION_ID=
MAXREAD_BOT_APP_ID=
