# Outlook.com: outlook.office365.com:993, SSL, OAuth2 required.
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=group@example.com
IMAP_MAILBOX=INBOX

# Prefer oauth2 for Outlook. Never commit the token or password.
IMAP_AUTH=oauth2
IMAP_OAUTH2_ACCESS_TOKEN=
IMAP_PASSWORD=
MS_CLIENT_ID=
MS_TENANT=consumers
MS_TOKEN_CACHE=./data/secrets/outlook-token.json

# Initial scan window and per-run guardrail.
MAIL_LOOKBACK_DAYS=30
MAIL_SCAN_LIMIT=100
MAIL_MAX_ATTACHMENT_MB=25
MAIL_READ_ONLY=1

MAIL_DATA_DIR=./data
MAIL_DB_PATH=./data/mail_collector.sqlite3

# Incremental recruiting pipeline. Keep the mailbox read-only; these settings
# only authorize writes to the Feishu candidate table and material documents.
RECRUITING_SCAN_INTERVAL_DAYS=1
RECRUITING_MODEL=gpt-5.6-sol
RECRUITING_REASONING_EFFORT=medium
RECRUITING_OPENAI_API_KEY=
RECRUITING_OPENAI_BASE_URL=https://api.openai.com/v1
RECRUITING_OPENAI_API_MODE=responses
RECRUITING_OPENAI_TIMEOUT=180
RECRUITING_LLM_CONCURRENCY=2
RECRUITING_PDF_WORKERS=4
RECRUITING_RETRY_ATTEMPTS=3
RECRUITING_RETRY_BASE_SECONDS=2
RECRUITING_RUN_STALE_MINUTES=10
RECRUITING_FEISHU_AS=bot
RECRUITING_LARK_CLI=lark-cli
RECRUITING_BASE_TOKEN=
RECRUITING_TABLE_ID=
RECRUITING_DOCS_PARENT_TOKEN=
RECRUITING_MARK_INTERVIEW_ASSIGNED=1
RECRUITING_NOTIFY_ENABLED=0
RECRUITING_NOTIFY_CHAT_ID=
