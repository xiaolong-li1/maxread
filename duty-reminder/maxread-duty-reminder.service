[Unit]
Description=MaxRead independent daily duty reminder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/maxread-duty
ExecStart=/opt/maxread-duty/run-duty-reminder.sh
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/root

[Install]
WantedBy=multi-user.target
