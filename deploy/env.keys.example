# Copy this file OUTSIDE the repo, e.g. ~/maxread.env, then fill real secrets there.
# For a private GitHub checkout, include MAXREAD_GITHUB_TOKEN locally; never commit it.
# deploy/install.sh copies this local file to <install-dir>/.env with chmod 600.

# Optional for bootstrap clone of the private repo. Token needs repo read access.
MAXREAD_GITHUB_TOKEN=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_SUB_MODULE=
MAXREAD_MODEL=gpt-5.5
MAXREAD_OPENAI_API_MODE=responses

# Feishu/Lark runtime
MAXREAD_FEISHU_AS=bot
MAXREAD_LARK_CLI=lark-cli
MAXREAD_BOT_NAMES=读不动了,MaxRead
# Optional, improves group mention detection if available
MAXREAD_BOT_OPEN_ID=
MAXREAD_BOT_UNION_ID=
MAXREAD_BOT_APP_ID=

# Local runtime paths; install.sh fills defaults if omitted.
# MAXREAD_DB=/opt/maxread/maxread.sqlite3
# MAXREAD_WORKDIR=/opt/maxread/var/maxread

MAXREAD_REQUIRE_SOURCE=true
MAXREAD_ARXIV_TIMEOUT=45
MAXREAD_ARXIV_PARALLEL_STREAMS=1
MAXREAD_ARXIV_PARALLEL_MIN_BYTES=1048576
MAXREAD_ARXIV_RELAY_URL=
MAXREAD_OPENAI_TIMEOUT=180
MAXREAD_OPENAI_REVIEW_TIMEOUT=240
MAXREAD_FEEDBACK_URL=

MAXREAD_QUEUE_WORKERS=2
MAXREAD_QUEUE_STALE_MINUTES=10
MAXREAD_QUEUE_HEARTBEAT_SECONDS=15
MAXREAD_RECOVERY_ATTEMPTS=3
MAXREAD_LLM_CONCURRENCY=5
MAXREAD_FEISHU_CONCURRENCY=1
MAXREAD_FEISHU_WRITE_RETRIES=3
MAXREAD_FEISHU_MEDIA_RETRIES=4
MAXREAD_FEISHU_DEFAULT_RETRIES=2

MAXREAD_GENERATION_REPAIR_ROUNDS=1
MAXREAD_QUALITY_REPAIR_ROUNDS=2
MAXREAD_AUTO_RETRY_ATTEMPTS=1
MAXREAD_SECTIONAL_GENERATION_ENABLED=true
MAXREAD_SECTIONAL_GENERATION_WORKERS=5
MAXREAD_FIGURE_VISION_WORKERS=2
MAXREAD_QUALITY_BLOCK_WORKERS=2
MAXREAD_MAX_IMAGE_DISPLAY_HEIGHT=560

# Keep false unless this machine has a verified Playwright/Chromium runner.
MAXREAD_VISUAL_QA_ENABLED=false
MAXREAD_VISUAL_QA_HOST=
MAXREAD_VISUAL_QA_RUNNER=
MAXREAD_VISUAL_QA_REMOTE_ROOT=
MAXREAD_VISUAL_QA_TIMEOUT=90
MAXREAD_VISUAL_QA_INSPECT_RETRIES=2
MAXREAD_VISUAL_QA_MAX_SECTIONS=12
MAXREAD_VISUAL_QA_MAX_REPAIRS=2
MAXREAD_VISUAL_QA_REPAIR_ROUNDS=2
MAXREAD_VISUAL_QA_CONCURRENCY=1
MAXREAD_VISUAL_QA_ROOT=/opt/maxread-browser
MAXREAD_VISUAL_QA_PYTHON=/opt/maxread/.venv/bin/python
PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright
MAXREAD_PLAYWRIGHT_NODE_MODULES=/opt/maxread/var/maxread/playwright-deps/node_modules
